    "\n",
    "class A:\n",
    "    x = 20\n",
    "    def __init__(self,y):\n",
    "        self.y = y\n",
    "    def display(self):\n",
    "        print(\"Hi\")\n",
    "obj = A(120)\n",
    "obj.display()\n",
    "print(obj.display())\n",
    "# we can access & modify class & instance variables in display function"
